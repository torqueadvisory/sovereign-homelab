# Nextcloud secrets — copy to .env and fill in. NEVER commit the real .env.
# Generate strong random values, e.g.:  openssl rand -base64 24 | tr -d '/+=' | cut -c1-24

MYSQL_ROOT_PASSWORD=<generate-strong-random>
MYSQL_PASSWORD=<generate-strong-random>
NEXTCLOUD_ADMIN_USER=<your-admin-username>
NEXTCLOUD_ADMIN_PASSWORD=<generate-strong-random>
