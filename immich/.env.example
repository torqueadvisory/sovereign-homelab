# Immich — copy to .env and fill in. NEVER commit the real .env.
# Immich ships its own official docker-compose.yml; pull it per the docs below,
# drop this .env beside it, then `docker compose up -d`.
#
#   curl -L https://github.com/immich-app/immich/releases/latest/download/docker-compose.yml -o docker-compose.yml
#   curl -L https://github.com/immich-app/immich/releases/latest/download/example.env -o .env
#
# Then set at least these:

UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=America/New_York
IMMICH_VERSION=release
DB_PASSWORD=<generate-strong-random>
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
